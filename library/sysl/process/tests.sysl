module sysl.process
@requires(posix)
@tests

import sysl.fs.IoError
import sysl.posix.time.monotonic
import sysl.time.whole_millis

// What starting another program promises, asserted in sysl rather than beside it in Scala.
//
// **These start real programs**, which is the only honest way to test this module: what it does is
// fork and exec, and a test that mocked either would be asserting the mock. The programs chosen are
// ones every hosted system has and whose behaviour is specified rather than conventional --
// `true`, `false`, `echo`, `printenv`, `pwd`.
//
// **They are named without a path wherever the point is not the path**, so that the `PATH` search
// `execvp` does is itself under test. A tool shelling out to `git` or `adb` depends on that search,
// and a module that only ever worked with absolute paths would pass every test here and be useless.
//
// Like `sysl.fs`'s, these depend on the library's own C: the shim under `__posix__` is what decodes
// how a child ended, so a build that did not compile or did not link it fails here rather than in
// whatever program first called it.

// ## Starting one, and how it ended

@test("a program that succeeds exits zero")
succeeds_exits_zero()
    assert_eq(run("true").unwrap(), Status.Exited(0))

// **`Ok` carrying a non-zero status, not `Err`.** The distinction is the module's central claim:
// `Err` is for a child that could not be *started*, and a program that ran and chose to fail has
// answered the question it was asked.
@test("a program that fails is still Ok, carrying its status")
fails_is_still_ok()
    val r = run("false")

    assert(r.is_ok(), "a program that exits non-zero still started")
    assert_eq(r.unwrap(), Status.Exited(1))

// **The case the report pipe exists for.** Without it a missing program is indistinguishable from
// one that ran and exited 127, because that is the status the child would have used to say so.
@test("a program that is not there is an error rather than a status")
missing_is_an_error()
    val r = run("sysl-no-such-program-anywhere-on-this-machine")

    assert(r.is_err(), "a program that cannot be started is an error")
    assert_eq(r.unwrap_err(), IoError.NotFound)

// A directory is not an executable, and the platform says so with a different number -- which is
// the evidence that the errno really travels back through the pipe rather than being invented here.
@test("a path that cannot be executed says why")
not_executable_says_why()
    val r = run("/")

    assert(r.is_err(), "a directory is not a program")
    assert(r.unwrap_err() != IoError.NotFound, "and the reason is not that it is missing")

// **A child that is killed rather than exiting**, which is the other half of `Status` and the only
// way to reach it: a signal has to come from somewhere, and a shell asked to kill itself is the
// shortest arrangement that always produces one. The one test here that uses a shell, and it uses
// it as a way to get a signal rather than as a way to run a command.
@test("a child that is killed reports the signal")
killed_reports_the_signal()
    assert_eq(run("sh", ["-c", "kill -9 $$"]).unwrap(), Status.Signalled(9))

// ## What it wrote

@test("what a program prints comes back")
prints_come_back()
    val out = capture("echo", ["hello"]).unwrap()

    assert_eq(out.text, "hello\n")
    assert(out.status.ok(), "and it exited cleanly")

// **Nothing goes through a shell, and this is what says so.** Under `/bin/sh` this argument would
// be three words and a second command; `execvp` hands it over exactly as written, so it comes back
// as one line of text.
@test("an argument is never read by a shell")
no_shell_reads_an_argument()
    val out = capture("echo", ["a b; rm -rf /; $HOME *"]).unwrap()

    assert_eq(out.text, "a b; rm -rf /; $HOME *\n")

@test("a program that prints nothing captures nothing")
silence_captures_nothing()
    val out = capture("true").unwrap()

    assert_eq(out.text, "")
    assert(out.status.ok())

// The temporary file a capture goes through is the module's own business and must not be left
// behind or reused while it is still held. Two in a row is the cheapest thing that would notice.
@test("two captures in a row do not collide")
captures_do_not_collide()
    assert_eq(capture("echo", ["one"]).unwrap().text, "one\n")
    assert_eq(capture("echo", ["two"]).unwrap().text, "two\n")

// ## Where it starts

@test("a child starts where it is told")
starts_where_told()
    assert_eq(capture("pwd", [], "/").unwrap().text, "/\n")

@test("an empty directory means wherever this program is")
empty_dir_means_here()
    val here = capture("pwd").unwrap().text

    assert(here.len > 1, "a path, rather than nothing")
    assert(here != "/\n", "and not the root, which is what the test above asked for")

// ## The environment

@test("a variable reaches the child")
a_variable_reaches_the_child()
    val out = capture("printenv", ["SYSL_PROCESS_TEST"], "",
                      [Var("SYSL_PROCESS_TEST", "present")]).unwrap()

    assert_eq(out.text, "present\n")

// **Added to the environment rather than replacing it**, which is why these are set in the child
// instead of being handed to `execve` as a whole `envp`. A child that had lost `PATH` because its
// parent set one variable could not find the next program it wanted.
@test("the rest of the environment survives")
rest_of_environment_survives()
    val out = capture("printenv", ["PATH"], "", [Var("SYSL_PROCESS_TEST", "present")]).unwrap()

    assert(out.text.len > 1, "PATH is still there alongside what was added")

// Named by an absolute path here, for the reason the next test exists.
@test("a variable the parent has is overridden for the child")
a_variable_is_overridden()
    val out = capture("/usr/bin/printenv", ["PATH"], "", [Var("PATH", "/nowhere")]).unwrap()

    assert_eq(out.text, "/nowhere\n")

// **Setting `PATH` changes where the program itself is looked for**, which is the one variable
// whose effect starts before the child does. The variables are set between the fork and the exec,
// so `execvp` searches the child's `PATH` rather than this program's -- consistent, and surprising
// the first time.
@test("setting PATH decides where the program is looked for")
path_decides_the_lookup()
    val r = capture("printenv", ["PATH"], "", [Var("PATH", "/nowhere")])

    assert(r.is_err(), "there is no printenv under /nowhere")
    assert_eq(r.unwrap_err(), IoError.NotFound)

// ## Status itself

@test("ok is exited zero and nothing else")
ok_is_exited_zero()
    assert(Status.Exited(0).ok())
    assert(!Status.Exited(1).ok())
    assert(!Status.Signalled(9).ok(), "a signal is never a success, whatever its number")
    assert(!Status.TimedOut.ok(), "and a child that was stopped never finished")

// **An exit status and a signal are different answers.** A shell folds them together as `128 + n`,
// which makes a program killed by `SIGKILL` indistinguishable from one that chose to exit 137.
@test("a signal is not an exit status")
signal_is_not_a_status()
    assert(Status.Exited(9) != Status.Signalled(9))
    assert(Status.Exited(137) != Status.Signalled(9))

// **A child that ran out of time was killed by a signal, and saying so would lose the one thing
// the caller knows**: which of the two it is deciding between is whether to report a crash or to
// wait longer next time.
@test("running out of time is not the same answer as being killed")
timed_out_is_not_a_signal()
    assert(Status.TimedOut != Status.Signalled(9))
    assert(Status.TimedOut != Status.Signalled(15))
    assert(Status.TimedOut != Status.Exited(0))
    assert(Status.TimedOut == Status.TimedOut)

@test("a status says which it is")
a_status_says_which()
    assert_eq(s"${Status.Exited(0)}", "exited")
    assert_eq(s"${Status.Exited(2)}", "exited 2")
    assert_eq(s"${Status.Signalled(9)}", "killed by signal 9")
    assert_eq(s"${Status.TimedOut}", "timed out")

// ## What it wrote to the OTHER stream
//
// **The claim these are about is that the two streams are separate**, so every one of them asserts
// something about `text` as well: a capture that quietly merged them would satisfy any test that
// only ever looked at `err`.

@test("standard error is left alone unless it is asked for")
stderr_is_not_collected_by_default()
    val out = capture("sh", ["-c", "echo out; echo boom >&2"]).unwrap()

    assert_eq(out.text, "out\n")
    assert(out.err.is_none(), "a call that did not ask for standard error says so with 'None'")

@test("standard error comes back when it is asked for, and the two streams stay apart")
stderr_comes_back_when_asked()
    val out = capture("sh", ["-c", "echo out; echo boom >&2"], "", [], true).unwrap()

    assert_eq(out.text, "out\n")
    assert_eq(out.err.unwrap(), "boom\n")

// **`None` and `Some("")` are the two answers a bare string could not tell apart**, which is the
// whole reason the field is an `Option`: a tool reporting why a child failed has to know whether it
// is looking at silence or at a stream nobody collected.
@test("a child that says nothing on standard error is not the same as not asking")
stderr_empty_is_not_absent()
    val asked = capture("true", [], "", [], true).unwrap()

    assert(asked.err.is_some(), "it was collected")
    assert_eq(asked.err.unwrap(), "")
    assert(capture("true").unwrap().err.is_none(), "and this one was not")
end stderr_empty_is_not_absent

// The reason the card exists: a failed child's diagnosis is on the stream a plain capture lets
// through to the terminal, where a tool cannot read it.
@test("a failed child's reason is readable rather than only its status")
stderr_carries_the_reason()
    val out = capture("sh", ["-c", "echo why >&2; exit 3"], "", [], true).unwrap()

    assert_eq(out.status, Status.Exited(3))
    assert_eq(out.err.unwrap(), "why\n")
    assert_eq(out.text, "")

// Two files rather than one, so the same collision the pair of captures above looks for is worth
// looking for across the streams of a single call.
@test("the two streams do not share a file")
stderr_does_not_collide_with_stdout()
    val out = capture("sh", ["-c", "echo aaa; echo bbb >&2"], "", [], true).unwrap()

    assert_eq(out.text, "aaa\n")
    assert_eq(out.err.unwrap(), "bbb\n")

// ## Running out of time
//
// **The claim is that a call which waits can be told to stop waiting**, and nothing else in this
// file asserts it: every other child here ends on its own. The ones below are asked to take far
// longer than the bound they are given, so each of these tests is a measurement -- how long the
// call took against how long the child wanted -- rather than an assertion that it came back at all.

@test("a child that outstays its timeout is stopped and says so")
outstaying_the_timeout_is_reported()
    val t0 = monotonic()
    val s = run("sleep", ["5"], "", [], 200).unwrap()
    val took = whole_millis(monotonic() - t0)

    assert_eq(s, Status.TimedOut)
    assert(!s.ok(), "a child that was stopped never finished, so it is not a success")
    assert(took < 3000, s"waited ${took}ms, which is the child's five seconds rather than the bound")
end outstaying_the_timeout_is_reported

// **Asked first and made second**, which is the whole of why there are two signals: a child that
// stops on `SIGTERM` gets to tidy up, and one that ignores it is still gone when the call returns.
// This one ignores it -- a disposition of "ignore" survives an `exec`, which is what lets the child
// be a single process rather than a shell holding one -- so the only way the call can come back
// before the child's own three seconds is the `SIGKILL` behind the grace.
@test("a child that ignores being asked to stop is made to")
ignoring_the_ask_is_still_stopped()
    val t0 = monotonic()
    val s = run("sh", ["-c", "trap '' TERM; exec sleep 3"], "", [], 200).unwrap()
    val took = whole_millis(monotonic() - t0)

    assert_eq(s, Status.TimedOut)
    assert(took < 2000, s"waited ${took}ms, so the child was never made to stop")
end ignoring_the_ask_is_still_stopped

// A bound is a bound rather than a deadline for the call: a child that finishes inside it is
// reported exactly as it would have been without one, failure included.
@test("a child that finishes inside its timeout is unaffected")
finishing_in_time_is_unaffected()
    assert_eq(run("true", [], "", [], 5000).unwrap(), Status.Exited(0))
    assert_eq(run("false", [], "", [], 5000).unwrap(), Status.Exited(1))

// Zero is the default, so this is what every other test in this file is relying on: a child that
// takes a whole second is waited for, and a bound of any size would have cut it short.
@test("a timeout of zero is no bound at all")
zero_is_no_bound()
    val t0 = monotonic()
    val s = run("sleep", ["1"], "", [], 0).unwrap()
    val took = whole_millis(monotonic() - t0)

    assert_eq(s, Status.Exited(0))
    assert(took >= 900, s"came back after ${took}ms, so something bounded a call that asked for none")
end zero_is_no_bound

// **What a child wrote before it ran out of time is usually what says where it stopped**, so the
// files are read whatever the status is rather than only when the child succeeded.
//
// The shell `exec`s what it waits on, here and above, so that the child is one process and not two.
// A shell that stayed would leave its own child behind holding the streams this test collects, and
// the timeout has no claim on a grandchild: the signals go to what was started, which is the same
// restraint that keeps this module out of process groups.
@test("what a child wrote before it ran out of time still comes back")
capture_keeps_what_was_written()
    val out = capture("sh", ["-c", "echo half; exec sleep 5"], "", [], false, 300).unwrap()

    assert_eq(out.status, Status.TimedOut)
    assert_eq(out.text, "half\n")

// The error half is about starting a child, and a bound on one that never started is not an answer
// to anything -- so a timeout must not turn a missing program into a status.
@test("a timeout does not change what a program that cannot start reports")
timeout_does_not_disturb_a_start_failure()
    val r = run("sysl-no-such-program-anywhere-on-this-machine", [], "", [], 1000)

    assert(r.is_err(), "a program that is not there cannot run out of time")
    assert_eq(r.unwrap_err(), IoError.NotFound)
end timeout_does_not_disturb_a_start_failure
