module sysl.math.bigint
@tests

import sysl.buf.{Buf, buf}
import sysl.math.Float
import sysl.rand.{Rng, rng}

// What `sysl.math.bigint` claims, asserted in sysl.
//
// **Division is checked two ways and NEITHER is enough on its own.** Two hundred generated pairs
// against `a == q * b + r` say the algorithm is consistent over inputs nobody chose, and named
// values say the answers are the right ones -- a broken multiply that a broken divide undoes would
// satisfy the identity and fail `100!`.
//
// **What generated pairs do NOT reach is the add-back, and this was measured rather than assumed.**
// Knuth's algorithm D corrects an over-large digit guess twice: a loop that tightens it, and an
// add-back for the one case the loop still gets wrong. The add-back fires about twice in every
// `2^32` digits, so two hundred pairs of a few limbs each have a chance of about one in three
// million of entering it -- and deleting the branch outright leaves all two hundred green. It is
// `div_correction_vectors` that reaches it, with an input constructed to, and that case fails the
// moment the branch is removed.
//
// The general lesson is the compiler's own: a fixture drawn from the common case exercises the
// common path, and a rare branch needs an input built for it.

/** A magnitude of `limbs` random limbs, built through the module's own constructor rather than
 * through arithmetic -- so a defect in `mul` cannot quietly shape the input that is meant to find
 * it.
 */
private random_big(g: *Rng, limbs: usize, minus: bool) -> BigInt
    var out: Buf[u32] = buf()

    for _ in 0..<limbs
        out.push(g.next_u32())

    val mag = trimmed(out)

    if mag.len == 0 then zero() else BigInt(minus, mag)
end random_big

// -- construction and the two ends of the conversion -----------------------------------------------

@test("a machine integer goes in and comes back")
from_and_to_long()
    assert_eq(from_int(0).to_long().unwrap(), 0)
    assert_eq(from_int(1).to_long().unwrap(), 1)
    assert_eq(from_int(-1).to_long().unwrap(), -1)
    assert_eq(from_int(9223372036854775807).to_long().unwrap(), 9223372036854775807)

    // The most negative `long` is the asymmetric one: its magnitude has no positive counterpart, so
    // the conversion cannot go through negating it.
    val most: long = -9223372036854775807 - 1

    assert_eq(from_int(most).to_long().unwrap(), most)
end from_and_to_long

@test("a value past what a long holds answers None rather than wrapping")
to_long_refuses()
    // `2^63` is one past the largest positive, and `-(2^63) - 1` one past the most negative.
    assert(parse("9223372036854775808").unwrap().to_long().is_none())
    assert(parse("-9223372036854775809").unwrap().to_long().is_none())
    assert(parse("340282366920938463463374607431768211456").unwrap().to_long().is_none())

@test("zero has one representation and it is not negative")
zero_is_canonical()
    assert(zero().is_zero())
    assert_eq(zero().sign(), 0)
    assert_eq(zero().limbs(), 0)

    // Every route to zero has to arrive at the same value, or equality and hashing stop agreeing.
    assert_eq(negate(zero()), zero())
    assert_eq(sub(from_int(7), from_int(7)), zero())
    assert_eq(mul(from_int(-7), zero()), zero())
    assert_eq(parse("-0").unwrap(), zero())
    assert_eq(to_string(parse("-0").unwrap()), "0")

// -- arithmetic ------------------------------------------------------------------------------------

@test("addition and subtraction over the four sign combinations")
add_sub_signs()
    val a = from_int(7)
    val b = from_int(3)

    assert_eq(add(a, b).to_long().unwrap(), 10)
    assert_eq(add(a, negate(b)).to_long().unwrap(), 4)
    assert_eq(add(negate(a), b).to_long().unwrap(), -4)
    assert_eq(add(negate(a), negate(b)).to_long().unwrap(), -10)
    assert_eq(sub(b, a).to_long().unwrap(), -4)

@test("addition carries across limbs")
add_carries()
    // `2^32 - 1` plus one is where a single limb runs out, and `2^64 - 1` plus one is where two do.
    assert_eq(to_string(add(parse("4294967295").unwrap(), one())), "4294967296")
    assert_eq(to_string(add(parse("18446744073709551615").unwrap(), one())), "18446744073709551616")

@test("subtraction borrows across limbs")
sub_borrows()
    assert_eq(to_string(sub(parse("4294967296").unwrap(), one())), "4294967295")
    assert_eq(to_string(sub(parse("18446744073709551616").unwrap(), one())), "18446744073709551615")

@test("multiplication of two values that each need two limbs")
mul_wide()
    val a = parse("12345678901234567890").unwrap()
    val b = parse("98765432109876543210").unwrap()

    assert_eq(to_string(mul(a, b)), "1219326311370217952237463801111263526900")
    assert_eq(mul(a, negate(b)).sign(), -1)
    assert_eq(mul(negate(a), negate(b)), mul(a, b))

@test("a factorial, which is the multiply asserted against a number nobody could have guessed")
mul_factorial()
    var f = one()

    for i in 1..<101
        f = mul(f, from_int(long(i)))

    assert_eq(to_string(f),
        "933262154439441526816992388562667004907159682643816214685929638952175999932299156089414639" +
        "76156518286253697920827223758251185210916864000000000000000000000000")
end mul_factorial

@test("powers, including the two conventions at a zero exponent")
powers()
    assert_eq(to_string(pow(from_int(2), 128)), "340282366920938463463374607431768211456")
    assert_eq(pow(from_int(7), 0), one())
    assert_eq(pow(zero(), 0), one())
    assert_eq(pow(zero(), 5), zero())
    assert_eq(to_string(pow(from_int(-3), 3)), "-27")
    assert_eq(to_string(pow(from_int(-3), 4)), "81")

// -- division ---------------------------------------------------------------------------------------

@test("division by one limb, which takes the short path")
div_short()
    val (q, r) = div_rem(parse("340282366920938463463374607431768211456").unwrap(), from_int(1000000007))

    assert_eq(to_string(q), "340282364538961911690641225597")
    assert_eq(to_string(r), "279632277")

@test("division truncates toward zero and the remainder takes the dividend's sign")
div_signs()
    // The rule C, Go, Rust and sysl's own `/` on machine integers all follow, and the one that makes
    // `a == q * b + r` hold. A floored division would answer -4 and 1 for the first of these.
    assert_eq(div(from_int(-7), from_int(2)).to_long().unwrap(), -3)
    assert_eq(rem(from_int(-7), from_int(2)).to_long().unwrap(), -1)
    assert_eq(div(from_int(7), from_int(-2)).to_long().unwrap(), -3)
    assert_eq(rem(from_int(7), from_int(-2)).to_long().unwrap(), 1)
    assert_eq(div(from_int(-7), from_int(-2)).to_long().unwrap(), 3)
    assert_eq(rem(from_int(-7), from_int(-2)).to_long().unwrap(), -1)

@test("a dividend smaller than the divisor is a zero quotient and itself")
div_smaller()
    val (q, r) = div_rem(from_int(3), from_int(1000))

    assert(q.is_zero())
    assert_eq(r.to_long().unwrap(), 3)

@test("division satisfies a == q*b + r over generated pairs")
div_identity()
    var g = rng(20260904, 1)

    for n in 0..<200
        val minus_a = n % 3 == 0
        val minus_b = n % 5 == 0
        val a = random_big(&g, 1 + usize(n % 7), minus_a)
        var b = random_big(&g, 1 + usize(n % 4), minus_b)

        if b.is_zero() then b = one()

        val (q, r) = div_rem(a, b)

        assert_eq(add(mul(q, b), r), a)
        assert(cmp(abs(r), abs(b)) < 0)

        // The remainder's sign is the dividend's, or it is zero. Nothing else is admissible, and
        // getting this wrong still satisfies the identity above.
        if !r.is_zero() then assert_eq(r.sign(), a.sign())
end div_identity

@test("the quotient guess is corrected, on inputs built to force each correction")
div_correction_vectors()
    // Hacker's Delight's own vectors for `divmnu`, which is the same algorithm. The first two make
    // the tightening loop run; the third forces the add-back, which is the branch two hundred
    // generated pairs never enter.
    val a1 = parse("39614081257132168796771975168").unwrap()
    val b1 = parse("9223372036854775809").unwrap()

    assert_eq(to_string(div(a1, b1)), "4294967295")
    assert_eq(to_string(rem(a1, b1)), "9223372032559808513")

    val a2 = parse("39614081275578912861891592192").unwrap()
    val b2 = parse("9223372041149743103").unwrap()

    assert_eq(to_string(div(a2, b2)), "4294967295")
    assert_eq(to_string(rem(a2, b2)), "9223372036854775807")

    // The add-back case. Delete the branch and this one alone goes red.
    val a3 = parse("2596108815186156682096451392634880").unwrap()
    val b3 = parse("39614081257132168796771975169").unwrap()

    assert_eq(to_string(div(a3, b3)), "65534")
    assert_eq(to_string(rem(a3, b3)), "39614081257132168796771909634")
end div_correction_vectors

@test("multiplication and division undo each other over generated pairs")
mul_div_round_trip()
    var g = rng(777, 3)

    for n in 0..<100
        val a = random_big(&g, 1 + usize(n % 5), false)
        var b = random_big(&g, 1 + usize(n % 3), false)

        if b.is_zero() then b = one()

        assert_eq(div(mul(a, b), b), a)
end mul_div_round_trip

// -- comparison, hashing, text ---------------------------------------------------------------------

@test("ordering puts every negative below every positive, and orders negatives by magnitude")
ordering()
    val big = parse("340282366920938463463374607431768211456").unwrap()

    assert(cmp(negate(big), from_int(-1)) < 0)
    assert(cmp(from_int(-1), zero()) < 0)
    assert(cmp(zero(), from_int(1)) < 0)
    assert(cmp(from_int(1), big) < 0)
    assert(negate(big) < from_int(-1))
    assert(big > from_int(1))
    assert_eq(cmp(big, big), 0)

@test("equal values hash alike and different ones do not")
hashing()
    val a = parse("340282366920938463463374607431768211456").unwrap()
    val b = parse("340282366920938463463374607431768211456").unwrap()

    assert_eq(a.hash(), b.hash())
    assert(a.hash() != negate(a).hash())
    assert(a.hash() != add(a, one()).hash())

@test("text goes out and comes back in every base the module takes")
text_round_trip()
    var g = rng(31415, 9)

    for n in 0..<40
        val x = random_big(&g, 1 + usize(n % 5), n % 2 == 0)

        for base in 2..<37
            assert_eq(parse_radix(to_string_radix(x, base), base).unwrap(), x)
end text_round_trip

@test("the written forms are the ones a reader expects")
text_forms()
    assert_eq(to_string(zero()), "0")
    assert_eq(to_string(from_int(-42)), "-42")
    assert_eq(to_string_radix(parse("255").unwrap(), 16), "ff")
    assert_eq(to_string_radix(parse("255").unwrap(), 2), "11111111")
    assert_eq(to_string_radix(parse("-255").unwrap(), 16), "-ff")
    assert_eq(to_string_radix(parse("340282366920938463463374607431768211455").unwrap(), 16),
              "ffffffffffffffffffffffffffffffff")

@test("parsing takes a sign and either case of digit, and refuses everything else")
parse_refuses()
    assert_eq(parse("+7").unwrap().to_long().unwrap(), 7)
    assert_eq(parse_radix("FF", 16).unwrap().to_long().unwrap(), 255)
    assert_eq(parse_radix("ff", 16).unwrap().to_long().unwrap(), 255)

    assert(parse("").is_none())
    assert(parse("-").is_none())
    assert(parse(" 7").is_none())
    assert(parse("7 ").is_none())
    assert(parse("1_000").is_none())
    assert(parse("0x10").is_none())
    assert(parse_radix("2", 2).is_none())
    assert(parse_radix("7", 1).is_none())
    assert(parse_radix("7", 37).is_none())

// -- the bit operations ----------------------------------------------------------------------------

/** `2^n`, built by the multiply rather than by a shift -- so that the shift can be asserted against
 * it without the assertion being the shift's own answer twice.
 */
private two_pow(n: usize) -> BigInt = pow(from_int(2), n)

@test("the bit operators answer what an infinite two's-complement reading says")
bitwise_named_values()
    // Every one of these is what Python answers, which is the reading this module adopted.
    assert_eq(and(from_int(-6), from_int(3)), from_int(2))
    assert_eq(or(from_int(-6), from_int(3)), from_int(-5))
    assert_eq(xor(from_int(-6), from_int(3)), from_int(-7))
    assert_eq(and(from_int(-6), from_int(-3)), from_int(-8))
    assert_eq(or(from_int(-6), from_int(-3)), from_int(-1))
    assert_eq(xor(from_int(-6), from_int(-3)), from_int(7))
    assert_eq(and(from_int(12), from_int(10)), from_int(8))
    assert_eq(or(from_int(12), from_int(10)), from_int(14))
    assert_eq(xor(from_int(12), from_int(10)), from_int(6))
end bitwise_named_values

@test("the complement is the subtraction it is defined to be")
bitwise_complement()
    assert_eq(not(from_int(5)), from_int(-6))
    assert_eq(not(from_int(-6)), from_int(5))
    assert_eq(not(zero()), from_int(-1))
    assert_eq(not(from_int(-1)), zero())

    // `~` dispatches to the same function, and complementing twice is the identity.
    assert_eq(~from_int(5), from_int(-6))
    assert_eq(not(not(from_int(1234567890123))), from_int(1234567890123))
end bitwise_complement

@test("the operators dispatch from the symbols as well as from the names")
bitwise_operators()
    val a = from_int(-6)
    val b = from_int(3)

    assert_eq(a & b, and(a, b))
    assert_eq(a | b, or(a, b))
    assert_eq(a ^ b, xor(a, b))
    assert_eq(a << 4, shl(a, 4))
    assert_eq(a >> 1, shr(a, 1))
end bitwise_operators

@test("the identities hold, including the ones only an infinite width gives")
bitwise_identities()
    val x = parse("-123456789012345678901234567890").unwrap()
    val ones = from_int(-1)

    assert_eq(and(x, ones), x)
    assert_eq(or(x, zero()), x)
    assert_eq(xor(x, x), zero())
    assert_eq(and(x, zero()), zero())
    assert_eq(or(x, ones), ones)
    assert_eq(xor(x, ones), not(x))
end bitwise_identities

@test("the operators agree with De Morgan and with each other over generated pairs")
bitwise_laws()
    var g = rng(271828, 18)

    for n in 0..<60
        val a = random_big(&g, 1 + usize(n % 4), n % 2 == 0)
        val b = random_big(&g, 1 + usize(n % 3), n % 3 == 0)

        // A pair of magnitudes of different lengths and every combination of signs, so the
        // complement width and the sign extension above the shorter operand are both exercised.
        assert_eq(not(and(a, b)), or(not(a), not(b)))
        assert_eq(not(or(a, b)), and(not(a), not(b)))
        assert_eq(or(and(a, b), xor(a, b)), or(a, b))
        assert_eq(add(and(a, b), or(a, b)), add(a, b))
end bitwise_laws

@test("a shift left multiplies and a shift right floors, across the limb boundaries")
shifts_named_values()
    assert_eq(shl(from_int(1), 32), two_pow(32))
    assert_eq(shl(from_int(1), 64), two_pow(64))
    assert_eq(shl(from_int(-1), 31), from_int(-2147483648))
    assert_eq(shl(zero(), 99), zero())

    // The flooring cases, which is where this disagrees with a truncating shift.
    assert_eq(shr(from_int(-1), 100), from_int(-1))
    assert_eq(shr(from_int(-7), 1), from_int(-4))
    assert_eq(shr(from_int(-8), 1), from_int(-4))
    assert_eq(shr(from_int(7), 1), from_int(3))
    assert_eq(shr(from_int(-1), 0), from_int(-1))
    assert_eq(shr(two_pow(64), 64), one())
    assert_eq(shr(from_int(5), 99), zero())
    assert_eq(shr(from_int(-5), 99), from_int(-1))
end shifts_named_values

@test("a shift is the multiplication or the floored division it claims to be")
shifts_against_arithmetic()
    var g = rng(161803, 7)

    for n in 0..<40
        val x = random_big(&g, 1 + usize(n % 4), n % 2 == 0)

        // 31, 32 and 33 are the interesting amounts: a limb boundary and either side of it.
        for k in 0..<5
            val amount = 30 + usize(k)
            val p = two_pow(amount)

            assert_eq(shl(x, amount), mul(x, p))
            assert_eq(shr(x, amount), div_floor(x, p))

        assert_eq(shr(shl(x, 97), 97), x)
end shifts_against_arithmetic

@test("the bit queries read the magnitude the way Python's do")
bit_queries()
    assert_eq(bit_length(zero()), 0)
    assert_eq(bit_length(one()), 1)
    assert_eq(bit_length(from_int(255)), 8)
    assert_eq(bit_length(from_int(256)), 9)
    assert_eq(bit_length(from_int(4294967295)), 32)
    assert_eq(bit_length(from_int(4294967296)), 33)
    assert_eq(bit_length(two_pow(64)), 65)

    // The sign is not one of the bits counted, so a value and its negation answer alike.
    assert_eq(bit_length(from_int(-255)), 8)
    assert_eq(bit_length(negate(two_pow(64))), 65)

    assert_eq(trailing_zeros(zero()), 0)
    assert_eq(trailing_zeros(one()), 0)
    assert_eq(trailing_zeros(from_int(12)), 2)
    assert_eq(trailing_zeros(two_pow(96)), 96)
    assert_eq(trailing_zeros(negate(two_pow(96))), 96)
end bit_queries

@test("a bit of a negative value is read off the endless run of ones above it")
test_bit_cases()
    assert(!test_bit(zero(), 0))
    assert(!test_bit(zero(), 1000))
    assert(test_bit(from_int(5), 0))
    assert(!test_bit(from_int(5), 1))
    assert(test_bit(from_int(5), 2))
    assert(!test_bit(from_int(5), 64))

    // `-1` is every bit, and `-2` is every bit but the lowest.
    assert(test_bit(from_int(-1), 0))
    assert(test_bit(from_int(-1), 500))
    assert(!test_bit(from_int(-2), 0))
    assert(test_bit(from_int(-2), 1))
    assert(test_bit(from_int(-2), 500))

    // Above a negative value's magnitude every bit is set, which is what the sign extension means.
    assert(test_bit(negate(two_pow(64)), 64))
    assert(test_bit(negate(two_pow(64)), 200))
    assert(!test_bit(negate(two_pow(64)), 63))
end test_bit_cases

@test("a bit of a positive value is the one the shift puts in the lowest place")
test_bit_against_shift()
    var g = rng(141421, 3)

    for n in 0..<20
        val x = random_big(&g, 2, n % 2 == 0)

        for i in 0usize..<70
            assert_eq(test_bit(x, i), is_odd(shr(x, i)))
end test_bit_against_shift

@test("parity is the lowest bit, and zero is even")
parity()
    assert(is_even(zero()))
    assert(!is_odd(zero()))
    assert(is_odd(one()))
    assert(is_even(from_int(-4)))
    assert(is_odd(from_int(-5)))
    assert(is_even(two_pow(64)))
    assert(is_odd(add(two_pow(64), one())))
end parity

// -- the conversions -------------------------------------------------------------------------------

@test("an unsigned word goes in and comes back, past where a long stops")
u64_round_trip()
    assert_eq(from_u64(0), zero())
    assert_eq(from_u64(1), one())
    assert_eq(to_u64(zero()).unwrap(), 0)
    assert_eq(from_u64(18446744073709551615u64), sub(two_pow(64), one()))
    assert_eq(to_u64(sub(two_pow(64), one())).unwrap(), 18446744073709551615u64)

    // The two refusals: a negative value has no unsigned reading here, and `2^64` does not fit.
    assert(to_u64(from_int(-1)).is_none())
    assert(to_u64(two_pow(64)).is_none())
end u64_round_trip

@test("fits_long answers the question to_long is about to answer")
fits_long_agrees()
    val most: long = -9223372036854775807 - 1

    assert(fits_long(zero()))
    assert(fits_long(from_int(most)))
    assert(fits_long(from_int(9223372036854775807)))
    assert(!fits_long(two_pow(63)))
    assert(!fits_long(negate(add(two_pow(63), one()))))
end fits_long_agrees

@test("a value inside a real's mantissa converts exactly")
to_real_exact()
    assert_eq(to_real(zero()), 0.0)
    assert_eq(to_real(one()), 1.0)
    assert_eq(to_real(from_int(-1)), -1.0)
    assert_eq(to_real(from_int(1000000000000000000)), 1.0e18)
    assert_eq(to_real(two_pow(53)), 9007199254740992.0)
    assert_eq(to_real(negate(two_pow(53))), -9007199254740992.0)
    assert_eq(to_real(two_pow(64)), 18446744073709551616.0)
end to_real_exact

@test("a value past the mantissa rounds to nearest, ties to even")
to_real_rounds()
    val base = two_pow(53)

    // `2^53 + 1` is exactly halfway between two representable values and goes to the even one; `+2`
    // is representable; `+3` is halfway again and goes up, the value below it being odd.
    assert_eq(to_real(add(base, from_int(1))), 9007199254740992.0)
    assert_eq(to_real(add(base, from_int(2))), 9007199254740994.0)
    assert_eq(to_real(add(base, from_int(3))), 9007199254740996.0)
    assert_eq(to_real(add(base, from_int(4))), 9007199254740996.0)

    // Rounding a run of ones up carries into a new bit, and the answer is the next power of two.
    assert_eq(to_real(sub(two_pow(64), one())), 18446744073709551616.0)
    assert_eq(to_real(negate(sub(two_pow(64), one()))), -18446744073709551616.0)
end to_real_rounds

@test("a value past what a real holds becomes an infinity with the right sign")
to_real_overflows()
    assert(to_real(two_pow(2000)).is_infinite())
    assert(to_real(two_pow(2000)) > 0.0)
    assert(to_real(negate(two_pow(2000))).is_infinite())
    assert(to_real(negate(two_pow(2000))) < 0.0)

    // The largest finite real is `(2^53 - 1) * 2^971`, and one bit past it overflows.
    val largest = mul(sub(two_pow(53), one()), two_pow(971))

    assert(!to_real(largest).is_infinite())
    assert(to_real(two_pow(1024)).is_infinite())
end to_real_overflows

@test("a real converts exactly, truncating toward zero")
from_real_cases()
    assert_eq(from_real(0.0).unwrap(), zero())
    assert_eq(from_real(2.5).unwrap(), from_int(2))
    assert_eq(from_real(-2.7).unwrap(), from_int(-2))
    assert_eq(from_real(0.5).unwrap(), zero())
    assert_eq(from_real(-0.5).unwrap(), zero())
    assert_eq(from_real(1.0e18).unwrap(), from_int(1000000000000000000))
    assert_eq(from_real(9007199254740992.0).unwrap(), two_pow(53))
    assert_eq(from_real(18446744073709551616.0).unwrap(), two_pow(64))
    assert_eq(from_real(-18446744073709551616.0).unwrap(), negate(two_pow(64)))
end from_real_cases

@test("a NaN and an infinity have no integer answer and say so")
from_real_refuses()
    assert(from_real(real.nan()).is_none())
    assert(from_real(real.infinity()).is_none())
    assert(from_real(0.0 - real.infinity()).is_none())

@test("the two directions undo each other wherever the value fits a mantissa")
real_round_trip()
    var g = rng(577215, 5)

    for n in 0..<40
        // One limb plus a low bit, which keeps every value inside 53 bits so the conversion out is
        // exact and the conversion back has something to be exact about.
        val x = random_big(&g, 1, n % 2 == 0)

        assert_eq(from_real(to_real(x)).unwrap(), x)
        assert_eq(from_real(to_real(mul(x, two_pow(20)))).unwrap(), mul(x, two_pow(20)))
end real_round_trip

// -- the floored division --------------------------------------------------------------------------

@test("floored division rounds toward negative infinity and the remainder takes the divisor's sign")
floor_division_signs()
    assert_eq(div_floor(from_int(7), from_int(2)), from_int(3))
    assert_eq(mod_floor(from_int(7), from_int(2)), from_int(1))
    assert_eq(div_floor(from_int(-7), from_int(2)), from_int(-4))
    assert_eq(mod_floor(from_int(-7), from_int(2)), from_int(1))
    assert_eq(div_floor(from_int(7), from_int(-2)), from_int(-4))
    assert_eq(mod_floor(from_int(7), from_int(-2)), from_int(-1))
    assert_eq(div_floor(from_int(-7), from_int(-2)), from_int(3))
    assert_eq(mod_floor(from_int(-7), from_int(-2)), from_int(-1))
end floor_division_signs

@test("an exact division is the same under both roundings")
floor_division_exact()
    assert_eq(div_floor(from_int(-6), from_int(2)), div(from_int(-6), from_int(2)))
    assert_eq(mod_floor(from_int(-6), from_int(2)), zero())
    assert_eq(div_floor(zero(), from_int(-3)), zero())
    assert_eq(mod_floor(zero(), from_int(-3)), zero())

@test("the floored pair satisfies a == q*b + r over generated pairs, with r inside the divisor")
floor_division_identity()
    var g = rng(123581, 13)

    for n in 0..<60
        val a = random_big(&g, 1 + usize(n % 4), n % 2 == 0)
        val b = random_big(&g, 1 + usize(n % 2), n % 3 == 0)

        if !b.is_zero()
            val (q, r) = div_rem_floor(a, b)

            assert_eq(add(mul(q, b), r), a)

            // The remainder lands strictly inside the divisor and carries the divisor's sign, which
            // is the property the truncating pair does not have.
            assert(cmp(abs(r), abs(b)) < 0)
            assert(r.is_zero() || r.minus == b.minus)
end floor_division_identity

// -- the number theory -----------------------------------------------------------------------------

@test("the greatest common divisor, and it is never negative")
gcd_cases()
    assert_eq(gcd(from_int(12), from_int(18)), from_int(6))
    assert_eq(gcd(from_int(-12), from_int(18)), from_int(6))
    assert_eq(gcd(from_int(12), from_int(-18)), from_int(6))
    assert_eq(gcd(from_int(-12), from_int(-18)), from_int(6))
    assert_eq(gcd(from_int(17), from_int(5)), one())
    assert_eq(gcd(from_int(-9), zero()), from_int(9))
    assert_eq(gcd(zero(), from_int(9)), from_int(9))
    assert_eq(gcd(zero(), zero()), zero())
    assert_eq(gcd(two_pow(64), two_pow(32)), two_pow(32))
end gcd_cases

@test("the greatest common divisor divides both and nothing larger does, over generated pairs")
gcd_divides()
    var g = rng(314159, 11)

    for n in 0..<40
        val a = random_big(&g, 1 + usize(n % 3), n % 2 == 0)
        val b = random_big(&g, 1 + usize(n % 2), n % 3 == 0)
        val d = gcd(a, b)

        if !d.is_zero()
            assert(rem(a, d).is_zero())
            assert(rem(b, d).is_zero())

            // Dividing both by it leaves a coprime pair, which is what "greatest" means.
            assert_eq(gcd(div(a, d), div(b, d)), one())
end gcd_divides

@test("the least common multiple, which never builds the whole product")
lcm_cases()
    assert_eq(lcm(from_int(4), from_int(6)), from_int(12))
    assert_eq(lcm(from_int(-4), from_int(6)), from_int(12))
    assert_eq(lcm(from_int(4), from_int(-6)), from_int(12))
    assert_eq(lcm(zero(), from_int(5)), zero())
    assert_eq(lcm(from_int(5), zero()), zero())
    assert_eq(lcm(two_pow(64), two_pow(32)), two_pow(64))
    assert_eq(lcm(from_int(17), from_int(5)), from_int(85))
end lcm_cases

@test("modular exponentiation agrees with the definition it is an optimization of")
mod_pow_against_definition()
    var g = rng(112358, 9)

    for n in 0..<30
        val b = random_big(&g, 1, n % 2 == 0)
        val m = abs(random_big(&g, 1, false))
        val e = usize(n % 12)

        if !m.is_zero()
            assert_eq(mod_pow(b, from_int(long(e)), m), mod_floor(pow(b, e), m))
end mod_pow_against_definition

@test("modular exponentiation at an exponent nothing could raise to directly")
mod_pow_named_values()
    assert_eq(mod_pow(from_int(2), from_int(10), from_int(1000)), from_int(24))
    assert_eq(mod_pow(from_int(3), zero(), from_int(7)), one())
    assert_eq(mod_pow(from_int(5), from_int(3), one()), zero())
    assert_eq(mod_pow(zero(), from_int(5), from_int(7)), zero())

    // Fermat's little theorem over a prime, at an exponent whose plain power has 300 million digits.
    val p = from_int(1000000007)

    assert_eq(mod_pow(from_int(2), from_int(1000000006), p), one())
    assert_eq(mod_pow(from_int(123456789), from_int(1000000006), p), one())

    // A negative modulus takes the modulus's sign, as the floored remainder does.
    assert_eq(mod_pow(from_int(2), from_int(3), from_int(-5)), from_int(-2))
end mod_pow_named_values

@test("the integer square root is the exact floor")
isqrt_cases()
    assert_eq(isqrt(zero()), zero())
    assert_eq(isqrt(one()), one())
    assert_eq(isqrt(from_int(2)), one())
    assert_eq(isqrt(from_int(3)), one())
    assert_eq(isqrt(from_int(4)), from_int(2))
    assert_eq(isqrt(from_int(8)), from_int(2))
    assert_eq(isqrt(from_int(9)), from_int(3))
    assert_eq(isqrt(from_int(10)), from_int(3))
    assert_eq(isqrt(two_pow(64)), two_pow(32))
    assert_eq(isqrt(sub(two_pow(64), one())), sub(two_pow(32), one()))
    assert_eq(isqrt(pow(from_int(10), 30)), pow(from_int(10), 15))
end isqrt_cases

@test("the square root squares back below the value and one more does not, over generated inputs")
isqrt_brackets()
    var g = rng(299792, 4)

    for n in 0..<40
        val x = abs(random_big(&g, 1 + usize(n % 4), false))
        val r = isqrt(x)
        val next = add(r, one())

        assert(cmp(mul(r, r), x) <= 0)
        assert(cmp(mul(next, next), x) > 0)
end isqrt_brackets

// -- the machine-sized operand -----------------------------------------------------------------------

@test("a comparison against a machine integer answers what the general one does")
cmp_long_agrees()
    var g = rng(602214, 6)
    val most: long = -9223372036854775807 - 1
    val edges: [9]long = [0, 1, -1, 2147483647, -2147483648, 4294967295, 4294967296,
                          9223372036854775807, most]

    for n in 0..<30
        val a = random_big(&g, 1 + usize(n % 4), n % 2 == 0)

        for e in edges
            assert_eq(cmp_long(a, e), cmp(a, from_int(e)))

    // And the named answers, so a broken `cmp` cannot make both sides agree on nonsense.
    assert_eq(cmp_long(zero(), 0), 0)
    assert_eq(cmp_long(from_int(-1), 0), -1)
    assert_eq(cmp_long(one(), 0), 1)
    assert_eq(cmp_long(two_pow(64), 9223372036854775807), 1)
    assert_eq(cmp_long(negate(two_pow(64)), most), -1)
end cmp_long_agrees

@test("the mixed arithmetic answers what the general arithmetic does")
mixed_long_agrees()
    var g = rng(662607, 15)
    val most: long = -9223372036854775807 - 1
    val edges: [9]long = [0, 1, -1, 7, -7, 4294967295, 4294967296, 9223372036854775807, most]

    for n in 0..<24
        val a = random_big(&g, 1 + usize(n % 4), n % 2 == 0)

        for e in edges
            assert_eq(add_long(a, e), add(a, from_int(e)))
            assert_eq(sub_long(a, e), sub(a, from_int(e)))
            assert_eq(mul_long(a, e), mul(a, from_int(e)))

            if e != 0
                val (q, r) = div_rem_long(a, e)
                val (gq, gr) = div_rem(a, from_int(e))

                assert_eq(q, gq)
                assert_eq(from_int(r), gr)
end mixed_long_agrees

@test("the mixed arithmetic is written out on values a reader can check")
mixed_long_named_values()
    assert_eq(add_long(two_pow(64), 1), add(two_pow(64), one()))
    assert_eq(sub_long(zero(), -9223372036854775807 - 1), two_pow(63))
    assert_eq(mul_long(two_pow(64), -3), negate(mul(from_int(3), two_pow(64))))
    assert_eq(mul_long(from_int(7), 0), zero())

    val (q, r) = div_rem_long(from_int(-7), 2)

    assert_eq(q, from_int(-3))
    assert_eq(r, -1)
end mixed_long_named_values
